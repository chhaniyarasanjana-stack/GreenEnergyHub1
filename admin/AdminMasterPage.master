    <!-- Footer Start -->
<div class="container-fluid bg-dark text-body footer mt-5 pt-5 wow fadeIn" data-wow-delay="0.1s">
        <div class="container py-5">
            <div class="row g-5">
    
            <div class="col-lg-3 col-md-6">
                <h5 class="text-white mb-4">Address</h5>
                <p class="mb-2"></i>123 Renewable Park, Morbi, Gujarat, India</p>
                <p class="mb-2"><i class="fa fa-phone-alt me-3"></i>+91 98765 43210</p>
                <p class="mb-2"><i class="fa fa-envelope me-3"></i>info@greenenergyhub.com</p>
            </div>

            <div class="col-lg-3 col-md-6">
                <h5 class="text-white mb-4">Quick Links</h5>
                <a class="btn btn-link" href="about.aspx">About Us</a>
                <a class="btn btn-link" href="contact.aspx">Contact Us</a>
                <a class="btn btn-link" href="service.aspx">Service</a>
            </div>

            <div class="col-lg-3 col-md-6">
                <h5 class="text-white mb-4">Project Gallery</h5>
                <div class="row g-2">
                    <div class="col-4"><img class="img-fluid rounded" src="img/gallery-1.jpg" /></div>
                    <div class="col-4"><img class="img-fluid rounded" src="img/gallery-2.jpg" /></div>
                    <div class="col-4"><img class="img-fluid rounded" src="img/gallery-3.jpg" /></div>
                    <div class="col-4"><img class="img-fluid rounded" src="img/gallery-4.jpg" /></div>
                    <div class="col-4"><img class="img-fluid rounded" src="img/gallery-5.jpg" /></div>
                    <div class="col-4"><img class="img-fluid rounded" src="img/gallery-6.jpg" /></div>
                    
                                    </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <h5 class="text-white mb-4">Newsletter</h5>
                <p>Green Energy Marketplace – Powering a sustainable future.</p>

                <div class="position-relative mx-auto" style="max-width: 400px;">
                    <input id="newsletterEmail" class="form-control border-0 w-100 py-3 ps-4 pe-5"
                           type="email" placeholder="Your email">
                    <button type="button"
                            class="btn btn-primary py-2 position-absolute top-0 end-0 mt-2 me-2"
                            onclick="newsletterSignup()">
                        SignUp
                    </button>
                </div>

                <small id="newsletterMsg" class="text-success" style="display:none;">
                    ✔ Successfully subscribed
                </small>
            </div>

        </div>
