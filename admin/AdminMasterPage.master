<script>
    function newsletterSignup() {
        var email = document.getElementById("newsletterEmail").value;

        if (email === "") {
            alert("Please enter email");
            return;
        }

        document.getElementById("newsletterMsg").style.display = "block";
    }
</script>

<body>
